# ===========================================
# DIRECTR - Environment Variables
# ===========================================
# Copy this file to .env and fill in your values

# ===========================================
# DATABASE (PostgreSQL - Required)
# ===========================================
DATABASE_URL="postgresql://username:password@localhost:5432/directr?schema=public"
DIRECT_URL="postgresql://username:password@localhost:5432/directr?schema=public"

# ===========================================
# CLERK AUTHENTICATION (Required)
# ===========================================
# Get these from https://dashboard.clerk.com
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_xxx"
CLERK_SECRET_KEY="sk_test_xxx"
CLERK_WEBHOOK_SECRET="whsec_xxx"

# Clerk redirect URLs
NEXT_PUBLIC_CLERK_SIGN_IN_URL="/sign-in"
NEXT_PUBLIC_CLERK_SIGN_UP_URL="/sign-up"
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL="/"
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL="/"

# ===========================================
# AWS S3 (Required for file uploads)
# ===========================================
AWS_ACCESS_KEY_ID="your-access-key-id"
AWS_SECRET_ACCESS_KEY="your-secret-access-key"
AWS_REGION="us-east-1"
S3_BUCKET="directr-user-uploads"

# ===========================================
# AI SERVICES
# ===========================================
# Replicate API for image generation
REPLICATE_API_TOKEN="r8_xxx"

# Google Gemini API for character DNA extraction
GEMINI_API_KEY="your-gemini-api-key"

# ===========================================
# OPTIONAL
# ===========================================
NODE_ENV="development"
